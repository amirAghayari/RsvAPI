# SERVER
NODE_ENV=development                    # application environment: development | production | test | deployment
IS_DOCKER=false                        # set to true when running inside Docker
PORT=3000                              # HTTP server port
FRONTEND_URL=localhost:5173             # frontend host for password reset links
LOG_LEVEL=info                         # logger verbosity: fatal | error | warn | info | debug

# DATABASE
DB_HOST=localhost                      # primary PostgreSQL host
DB_PORT=5432                           # primary PostgreSQL port
DB_USERNAME=postgres                   # primary database username
DB_PASSWORD=password                   # primary database password
DB_NAME=ticket_db                      # primary application database name
TEST_DB_HOST=localhost                 # test database host
TEST_DB_PORT=5432                      # test database port
TEST_DB_USERNAME=postgres              # test database username
TEST_DB_PASSWORD=password              # test database password
TEST_DB_NAME=ticket_express_test       # test database name

# REDIS
REDIS_URL=redis://localhost:6379       # Redis connection URL for rate limiting/cache
TEST_REDIS_URL=redis://localhost:6379  # Redis connection URL used during tests

# AUTHENTICATION
JWT_SECRET=replace-with-strong-secret            # legacy JWT secret for token utilities
JWT_ACCESS_SECRET=replace-with-strong-secret     # access token signing secret
JWT_REFRESH_SECRET=replace-with-strong-secret    # refresh token signing secret
JWT_COOKIE_EXPIRES_IN=15m                         # access token cookie expiration
JWT_REFRESH_COOKIE_EXPIRES_IN=7d                  # refresh token cookie expiration
ACCESS_TOKEN_EXPIRES_IN=15m                       # access token lifetime
REFRESH_TOKEN_EXPIRES_IN=7d                       # refresh token lifetime
BYCRYPT_SALT_ROUNDS=10                            # bcrypt salt rounds for password hashing
PASSWORD_RESET_EXPIRES_IN=10m                     # password reset token lifetime

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=demo                      # Cloudinary cloud name
CLOUDINARY_API_KEY=123456789012345             # Cloudinary API key
CLOUDINARY_API_SECRET=abcdefg1234567           # Cloudinary API secret

# EMAIL
EMAIL_HOST=smtp.gmail.com                      # SMTP host for sending email
EMAIL_PORT=465                                  # SMTP port
EMAIL_USERNAME=your-email@example.com           # SMTP username
EMAIL_PASSWORD=your-email-password              # SMTP password

# PAYMENT INTEGRATION
ZARINPAL_SANDBOX=true                          # enable Zarinpal sandbox mode for testing
ZARINPAL_MERCHANT_ID=XXXXXXXXXXXXXXXXXXXXXXXX   # Zarinpal merchant ID
ZARINPAL_CALLBACK_URL=https://example.com/api/V1/payments/verify  # Zarinpal callback URL