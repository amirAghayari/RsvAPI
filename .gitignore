# Node modules
node_modules/

# Build outputs
dist/
build/
lib/

# TypeScript cache
*.tsbuildinfo

# Environment files (do NOT commit real secrets)
.env
.env.*.local
.env.local

# Logs
logs/
*.log
npm-debug.log*

# Coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Optional: package manager lock files (uncomment if you don't want to track them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# TypeORM migration outputs (if generated into dist)
src/migrations/*.js

# Others
*.tgz
