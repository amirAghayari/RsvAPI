{
  "name": "event-ticketing-API",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start:dev": "nodemon src/server.ts",
    "start": "ts-node-dev --respawn src/server.ts",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/server.ts\"",
    "build": "rimraf ./dist && tsc",
    "migrate:generate": "typeorm-ts-node-esm migration:generate src/migrations/init -d src/config/dataSource.ts",
    "migrate:run": "typeorm-ts-node-esm migration:run -d src/config/dataSource.ts",
    "migrate:revert": "typeorm-ts-node-esm migration:revert -d src/config/dataSource.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirAghayari/ticket-express.git"
  },
  "keywords": [],
  "author": "Amir Aghayari",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/amirAghayari/ticket-express/issues"
  },
  "homepage": "https://github.com/amirAghayari/ticket-express#readme",
  "description": "",
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "morgan": "^1.11.0",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui": "^5.31.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0",
    "xss": "^1.0.15",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.2",
    "@types/nodemailer": "^8.0.1",
    "@types/streamifier": "^0.1.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "nodemonConfig": {
    "events": {
      "start": "echo '--------------------\n'& clear || cls"
    }
  }
}
