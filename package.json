{
  "name": "ticket-express",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "ts-node-dev --respawn src/app.ts",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/app.ts\"",
    "build": "rimraf ./dist && tsc",
    "migrate:generate": "typeorm-ts-node-commonjs migration:generate src/migrations/init -d src/config/data-source.ts",
    "migrate:run": "typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts",
    "migrate:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/data-source.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirAghayari/ticket-express.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/amirAghayari/ticket-express/issues"
  },
  "homepage": "https://github.com/amirAghayari/ticket-express#readme",
  "description": "",
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui": "^5.31.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.2",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
